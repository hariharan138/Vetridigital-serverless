PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/cron/daily-report. Set the same value as a Vercel env var.
CRON_SECRET=choose_a_random_secret

# Daily 9 PM IST PDF report — comma-separated recipient emails
REPORT_EMAILS=owner@example.com,accounts@example.com,manager@example.com
# For Gmail: set SMTP_SERVICE=gmail and use an App Password (not your login password)
SMTP_SERVICE=gmail
SMTP_USER=yourmail@gmail.com
SMTP_PASS=your_app_password
# Or use a custom SMTP server instead of SMTP_SERVICE:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
